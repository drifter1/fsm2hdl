{# This file specifies macros for outputting generation information. #}
{# These macros are shared between Verilog and VHDL. #}

{%- macro gen_conf_vector_text(gen_conf_vector) -%}
Generator configuration vector: {{ gen_conf_vector }}
{%- endmacro %}

{%- macro summary_text(summary) -%}
Generated by fsm2hdl - {{ summary }}
{%- endmacro %}

{%- macro timestamp_text(timestamp) -%}
Generated: {{ timestamp }}
{%- endmacro %}

{%- macro version_text(version) -%}
This file has been automatically generated using fsm2hdl v{{ version }}
{%- endmacro %}