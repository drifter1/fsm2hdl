{%- from 'verilog/state_transition_condition.j2' import state_transition_condition -%}

{%- macro next_state(state_transitions, state_name) -%}
{%- for transition in state_transitions %}
    {%- if transition.inputs[0].name != '1' %}
        {%- if loop.first and loop.last %}
    if ({{ state_transition_condition(transition) }}) begin
        state_next = {{ transition.state_target }};
    end
    else begin
        state_next = {{ state_name }};
    end
        {%- elif loop.first %}
    if ({{ state_transition_condition(transition) }}) begin
        state_next = {{ transition.state_target }};
    end
        {%- elif loop.last %}
    else if ({{ state_transition_condition(transition) }}) begin
        state_next = {{ transition.state_target }};
    end
    else begin
        state_next = {{ state_name }};
    end
        {%- else %}
    else if ({{ state_transition_condition(transition) }}) begin
        state_next = {{ transition.state_target }};
    end
        {%- endif %}
    {%- else %}
    state_next = {{ transition.state_target }};
    {%- endif %}
{%- endfor %}
{%- endmacro %}