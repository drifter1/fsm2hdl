{%- from 'vhdl/all_in_one.j2' import all_in_one_moore, all_in_one_mealy -%}
{%- from 'vhdl/outputs.j2' import all_outputs_zeroed_non_blocking -%}
{%- from 'vhdl/state_condition.j2' import state_condition -%}

{%- if output_handling_method == 'ALL_OUTPUTS_ZEROED_BEFORE_STATE_LOGIC' -%}
{%- filter indent(0) %}
{{ all_outputs_zeroed_non_blocking(fsm.outputs) }}
{% endfilter %}
{%- endif %}
{%- if combinatorial_structure == 'CASE_WITH_NESTED_IF_ELSE' %}
case state is
{%- for state in fsm.states.values() %}
    {{ state_condition(combinatorial_structure, state.name, False) }}
        {%- if fsm.fsm_type.name == 'MOORE' -%}
        {{ all_in_one_moore(output_handling_method, fsm.outputs, state.outputs, state.transitions, state.name) | indent(4)}}
        {%- elif fsm.fsm_type.name == 'MEALY' -%}
        {{ all_in_one_mealy(output_handling_method, fsm.outputs, state.transitions, state.name) | indent(4) }}
        {%- endif %}
{%- endfor %}
    when others =>
        {%- if output_handling_method == 'ALL_OUTPUTS_SET_FROM_STATE_LOGIC' -%}
        {{ all_outputs_zeroed_non_blocking(fsm.outputs) | indent(8)}}
        {% endif %}
        state <= {{ default_state }};
end case;
{%- elif combinatorial_structure == 'IF_ELSE_NESTED' %}
{%- for state in fsm.states.values() %}
{%- if loop.first %}
{{ state_condition(combinatorial_structure, state.name, True) }}
{%- else %}
{{ state_condition(combinatorial_structure, state.name, False) }}
{%- endif %}
    {%- if fsm.fsm_type.name == 'MOORE' -%}
    {{ all_in_one_moore(output_handling_method, fsm.outputs, state.outputs, state.transitions, state.name) }}
    {%- elif fsm.fsm_type.name == 'MEALY' -%}
    {{ all_in_one_mealy(output_handling_method, fsm.outputs, state.transitions, state.name) }}
    {%- endif %}
{%- endfor %}
else
    {%- if output_handling_method == 'ALL_OUTPUTS_SET_FROM_STATE_LOGIC' -%}
    {{ all_outputs_zeroed_non_blocking(fsm.outputs) | indent(4)}}
    {% endif %}
    state <= {{ default_state }};
end if;
{%- endif %}