{%- from 'verilog/combined_next_state_output.j2' import combined_next_state_output_moore, combined_next_state_output_mealy -%}
{%- from 'verilog/outputs.j2' import fsm_outputs_all_zeroed -%}
{%- from 'verilog/sensitivity_list.j2' import next_state_sensitivity_list -%}
{%- from 'verilog/state_condition.j2' import state_condition -%}

// combined state transition and output logic
always @({{ next_state_sensitivity_list(combinatorial_sensitivity_mode, fsm.inputs) }}) begin
    {%- if output_handling_method == 'ALL_OUTPUTS_ZEROED_BEFORE_STATE_LOGIC' -%}
    {{- fsm_outputs_all_zeroed(coding_structure, fsm.outputs) | indent(4) }}
    {% endif %}
    {%- if combinatorial_structure == 'CASE_WITH_NESTED_IF_ELSE' %}
    case (state)
    {%- for state in fsm.states.values() %}
        {{ state_condition(combinatorial_structure, state.name, False) }} begin
            {%- if fsm.fsm_type.name == 'MOORE' -%}
            {{ combined_next_state_output_moore(coding_structure, output_handling_method, fsm.outputs, state.outputs, state.transitions, state.name) | indent(8)}}
            {%- elif fsm.fsm_type.name == 'MEALY' -%}
            {{ combined_next_state_output_mealy(coding_structure, output_handling_method, fsm.outputs, state.transitions, state.name) | indent(8) }}
            {%- endif %}
        end
    {%- endfor %}
        default : begin
            {%- if output_handling_method == 'ALL_OUTPUTS_SET_FROM_STATE_LOGIC' -%}
            {{- fsm_outputs_all_zeroed(coding_structure, fsm.outputs) | indent(12) }}
            {% endif %}
            state_next = {{ default_state }};
        end
    endcase
    {%- elif  combinatorial_structure == 'IF_ELSE_NESTED' %}
{%- for state in fsm.states.values() %}
    {%- if loop.first %}
    {{ state_condition(combinatorial_structure, state.name, True) }}
    {%- else %}
    {{ state_condition(combinatorial_structure, state.name, False) }}
    {%- endif %} begin
        {%- if fsm.fsm_type.name == 'MOORE' -%}
        {{ combined_next_state_output_moore(coding_structure, output_handling_method, fsm.outputs, state.outputs, state.transitions, state.name) | indent(4)}}
        {%- elif fsm.fsm_type.name == 'MEALY' -%}
        {{ combined_next_state_output_mealy(coding_structure, output_handling_method, fsm.outputs, state.transitions, state.name) | indent(4) }}
        {%- endif %}
    end
{%- endfor %}
    else begin
        {%- if output_handling_method == 'ALL_OUTPUTS_SET_FROM_STATE_LOGIC' -%}
        {{- fsm_outputs_all_zeroed(coding_structure, fsm.outputs) | indent(8) }}
        {% endif %}
        state_next = {{ default_state }};
    end
    {%- endif %}
end