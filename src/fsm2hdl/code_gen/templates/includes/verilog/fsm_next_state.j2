{%- from 'verilog/next_state.j2' import next_state -%}
{%- from 'verilog/sensitivity_list.j2' import next_state_sensitivity_list -%}
{%- from 'verilog/state_condition.j2' import state_condition -%}

// next state logic
always @({{ next_state_sensitivity_list(combinatorial_sensitivity_mode, fsm.inputs) }}) begin
    {%- if combinatorial_structure == 'CASE_WITH_NESTED_IF_ELSE' %}
    case (state)
    {%- for state in fsm.states.values() %}
        {{ state_condition(combinatorial_structure, state.name, False) }} begin
            {{- next_state(state.transitions, state.name) | indent(8) }}
        end
    {%- endfor %}
        default : begin
            state_next = {{ default_state }};
        end
    endcase
    {%- elif  combinatorial_structure == 'IF_ELSE_NESTED' %}
{%- for state in fsm.states.values() %}
    {%- if loop.first %}
    {{ state_condition(combinatorial_structure, state.name, True) }}
    {%- else %}
    {{ state_condition(combinatorial_structure, state.name, False) }}
    {%- endif %} begin
        {{- next_state(state.transitions, state.name) | indent(4) }}
    end
{%- endfor %}
    else begin
        state_next = {{ default_state }};
    end
    {%- endif %}
end